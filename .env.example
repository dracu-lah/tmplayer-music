# TMPlayer Music build configuration, by example. No real values here, ever.
#
# Nothing in this file is needed to build a debug APK: without the Telegram values the app compiles
# and runs and says so on the sign in screen, and without the signing values a release build is
# simply unsigned. A fork, a pull request and a CI run all build with none of this present.
#
# Locally the Telegram values belong in local.properties, which is gitignored:
#
#   TG_API_ID=1234567
#   TG_API_HASH=...
#
# and the signing values in keystore.properties, also gitignored:
#
#   storeFile=release.keystore
#   storePassword=...
#   keyAlias=...
#   keyPassword=...
#
# The build also reads TG_API_ID and TG_API_HASH from the environment when local.properties has
# none. In CI every value is a repository secret (the release workflow reads them from the
# "release" environment). Set them with the GitHub CLI, from the root of the repository:
#
#   gh secret set TG_API_ID
#   gh secret set TG_API_HASH
#   base64 -w0 release.keystore | gh secret set KEYSTORE_BASE64
#   gh secret set KEYSTORE_PASSWORD
#   gh secret set KEY_ALIAS
#   gh secret set KEY_PASSWORD
#
# gh reads each value from the terminal without echoing it or putting it in your shell history.
# `gh secret list` shows what is set; the values themselves cannot be read back out.


# --- Telegram -------------------------------------------------------------------------------
#
# Your own free credentials from https://my.telegram.org. They are per developer, not per project:
# do not use anybody else's, and do not put yours in a pull request. The published APK uses the
# project's own registered credentials, which live only in the repository secrets.

TG_API_ID=
TG_API_HASH=


# --- Release signing ------------------------------------------------------------------------
#
# Only the release workflow needs these. KEYSTORE_BASE64 is the keystore file, base64 encoded on
# one line; the workflow decodes it to release.keystore, writes keystore.properties from the three
# values below, builds, and deletes both before anything is uploaded. An APK signed with another
# key cannot update an installed one, so keep the keystore and its passwords safe and backed up.

KEYSTORE_BASE64=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
