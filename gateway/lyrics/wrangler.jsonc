{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A Cloudflare Pages project (static public/ plus the Functions in functions/), not a Worker:
  // tmplayer.org's DNS is not on Cloudflare, and a Pages custom domain works with a plain CNAME at
  // any DNS provider. The custom domain meta.tmplayer.org is added in the dashboard, not here.
  "name": "tmplayer-music-lyrics-gateway",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-10-01",

  // Privacy: Pages Functions have no Workers Logs setting to turn on, and we add none: no console
  // calls, no Logpush, no analytics bindings. Do not run `wrangler pages deployment tail` against it
  // for anything but a broken deploy; it would show request URLs.

  "vars": {
    "USER_AGENT": "TMPlayerMusic-gateway/1.0 (https://tmplayer.org)",
    // MusicBrainz and the Cover Art Archive (/v1/cover) ask for a contact in every User-Agent.
    "COVER_USER_AGENT": "TMPlayerMusic-gateway/1 (https://music.tmplayer.org)"
  }

  // No rate limiting binding: Pages Functions do not support `ratelimits` (a Workers only binding).
  // The per-client and upstream limits are counters in each isolate's memory, see src/index.ts.
}
