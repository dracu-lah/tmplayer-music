---
// The placeholder home page: what the app is in one line, the unofficial notice, the links, three
// framed phones in the hero, a sideways gallery of screenshots, a small "Chip in" block (Buy Me a
// Coffee first, as tmplayer.org has it) and the footer. No download button and no feature list
// until there is a release to point at. It is noindex while INDEXABLE in site.config.mjs is false.
//
// The screenshots come from scripts/prepare-screenshots.py (demo data, invented names), in the app's
// one pure black look. The gallery scrolls sideways with snap points and has Previous and Next
// buttons; nothing moves by itself.
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import { INDEXABLE } from '../../site.config.mjs';
import { SOFTWARE_APP, WEBSITE } from '../lib/app-ld';
import CoffeeButton from '../components/CoffeeButton.astro';
import Footer from '../components/Footer.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import { REPO_URL as REPO, SPONSORS_URL } from '../lib/support';

const SHOTS = [
  { screen: 'home', title: 'Home with Speed dial', text: 'Speed dial keeps the tracks you come back to one tap away, with what you played recently below.', alt: 'The Home screen: a Speed dial grid of track covers, a Shuffle all button and Recently played.' },
  { screen: 'chats', title: 'Chats', text: 'Each chat you picked opens as a playlist of its tracks.', alt: 'The Chats screen: chats with their track counts and a play button each.' },
  { screen: 'songs', title: 'Songs', text: 'Every track from your chats in one list, with an A to Z index.', alt: 'The Library on its Songs tab: tracks with covers, artists and lengths, and an A to Z index on the side.' },
  { screen: 'albums', title: 'Albums', text: 'Tracks grouped by album artist, album and year, read from the tags in the files.', alt: 'The Albums tab: a grid of album covers with their artists.' },
  { screen: 'nowplaying', title: 'Now Playing', text: 'The cover, a seek bar, shuffle and repeat.', alt: 'Now Playing: a large cover, the track title and artist, a seek bar and the playback buttons.' },
  { screen: 'lyrics', title: 'Lyrics', text: 'Synced lyrics follow the track, the current line lit.', alt: 'The lyrics page of Now Playing: lines of lyrics with the current one in bold white.' },
  { screen: 'queue', title: 'Queue', text: 'See what plays next, reorder it or take tracks out.', alt: 'The queue sheet over Now Playing: seven tracks with drag handles and remove buttons.' },
  { screen: 'account', title: 'Account menu', text: 'Settings, the chats that are read, Send logs and Log out, one tap from Home.', alt: 'The account menu open over Home: the signed in account, Settings, Manage chats, Send logs, About and Log out.' },
];
const GALLERY_SIZES = '(max-width: 480px) 62vw, 250px';
const HERO_SIZES = '(max-width: 640px) 44vw, 270px';
---
<Base
  path="/"
  title="TMPlayer Music: coming soon"
  description="TMPlayer Music is a player for the audio files already in your own Telegram chats. It is still being built. Unofficial, not affiliated with Telegram."
>
  <Fragment slot="head">
    <JsonLd data={WEBSITE} />
    {INDEXABLE && <JsonLd data={SOFTWARE_APP} />}
  </Fragment>

  <main id="main" class="home">
    <section class="hero" aria-labelledby="title">
      <div class="hero-text">
        <img class="mark" src="/favicon.svg" width="96" height="96" alt="">
        <p class="eyebrow">Coming soon</p>
        <h1 id="title">TMPlayer Music</h1>
        <p class="lede">A player for the audio files already in your own Telegram chats. It is still being built; below is how it looks so far.</p>
        <p class="notice">Unofficial, not affiliated with Telegram.</p>
        <nav class="links" aria-label="Links">
          <a href={REPO}>Source on GitHub</a>
          <a href="https://tmplayer.org/legal/">Legal</a>
          <a href="https://tmplayer.org/">TMPlayer, for the videos in your chats</a>
        </nav>
      </div>
      <div class="hero-phones">
        <PhoneFrame class="hp hp-side hp-left" screen="albums" alt="The Albums tab: a grid of album covers." sizes={HERO_SIZES} eager />
        <PhoneFrame class="hp hp-front" screen="home" alt="The Home screen with its Speed dial of track covers." sizes={HERO_SIZES} eager priority />
        <PhoneFrame class="hp hp-side hp-right" screen="nowplaying" alt="Now Playing: a large cover, a seek bar and the playback buttons." sizes={HERO_SIZES} eager />
      </div>
    </section>

    <section class="gallery" aria-labelledby="shots">
      <div class="gallery-head">
        <h2 id="shots">Screenshots</h2>
        <div class="gallery-tools">
          <div class="gallery-nav" data-gallery-nav hidden>
            <button type="button" data-step="-1" aria-label="Previous screenshots"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button type="button" data-step="1" aria-label="Next screenshots"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
        </div>
      </div>
      <p class="gallery-note">The screenshots use demo data: every track, album, artist and chat name in them is invented.</p>
      <ul class="shots" tabindex="0" aria-label="Screenshots, scroll sideways" data-gallery>
        {SHOTS.map((s) => (
          <li>
            <figure>
              <PhoneFrame screen={s.screen} alt={s.alt} sizes={GALLERY_SIZES} />
              <figcaption><strong>{s.title}</strong> {s.text}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <section class="chip-in" aria-labelledby="chip-in">
      <h2 id="chip-in">Chip in, if you like</h2>
      <p>TMPlayer Music is free and open source, with no ads of its own and no paid tier. A coffee or a sponsorship pays for the time that goes into it. It is voluntary and unlocks nothing.</p>
      <div class="support-coffee">
        <CoffeeButton />
        <a class="support-alt" href={SPONSORS_URL} rel="noopener">Sponsor on GitHub</a>
        <a class="support-alt" href="/support/">Other ways to help</a>
      </div>
    </section>
  </main>
  <Footer wide />
</Base>

<script>
  // The gallery's Previous and Next buttons, shown only when this runs. No timers, nothing stored;
  // the step is one phone, and the scroll is instant under reduced motion.
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const nav = document.querySelector<HTMLElement>('[data-gallery-nav]');
  if (gallery && nav) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    nav.querySelectorAll<HTMLButtonElement>('button[data-step]').forEach((b) => {
      b.addEventListener('click', () => {
        const item = gallery.querySelector('li');
        const step = item ? item.getBoundingClientRect().width : gallery.clientWidth / 2;
        gallery.scrollBy({ left: Number(b.dataset.step) * step, behavior: reduce.matches ? 'auto' : 'smooth' });
      });
    });
    nav.hidden = false;
  }
</script>
