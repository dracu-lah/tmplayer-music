---
// The home page: what the app is in one line, the unofficial notice, the links with a download
// button for the latest release, three framed phones in the hero, a sideways gallery of screenshots,
// a small "Chip in" block (Buy Me a Coffee first, as tmplayer.org has it), a card for the sibling app
// TMPlayer and the footer. It is noindex while INDEXABLE in site.config.mjs is false.
//
// The screenshots come from scripts/prepare-screenshots.py (demo data, invented names), in the app's
// one pure black look. The gallery scrolls sideways with snap points and has Previous and Next
// buttons; nothing moves by itself.
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import { INDEXABLE } from '../../site.config.mjs';
import { ORGANIZATION, SOFTWARE_APP, WEBSITE } from '../lib/app-ld';
import SponsorOffer from '../components/SponsorOffer.astro';
import release from '../data/release.json';
import PhoneFrame from '../components/PhoneFrame.astro';
import Icon from '../components/Icon.astro';
import Sibling from '../components/Sibling.astro';
import { REPO_URL as REPO } from '../lib/support';
import { t } from '../i18n/t';
import T from '../components/T.astro';

const SCREENS = ['home', 'chats', 'songs', 'albums', 'nowplaying', 'lyrics', 'queue', 'account'];
// i18n-keys: home.shot_home_h, home.shot_home, home.shot_home_alt, home.shot_chats_h, home.shot_chats, home.shot_chats_alt, home.shot_songs_h, home.shot_songs, home.shot_songs_alt, home.shot_albums_h, home.shot_albums, home.shot_albums_alt, home.shot_nowplaying_h, home.shot_nowplaying, home.shot_nowplaying_alt, home.shot_lyrics_h, home.shot_lyrics, home.shot_lyrics_alt, home.shot_queue_h, home.shot_queue, home.shot_queue_alt, home.shot_account_h, home.shot_account, home.shot_account_alt
const SHOTS = SCREENS.map((screen) => ({ screen, title: t(`home.shot_${screen}_h`), text: t(`home.shot_${screen}`), alt: t(`home.shot_${screen}_alt`) }));
const FEATURES = [
  { icon: 'music' as const, key: 'library' },
  { icon: 'layers' as const, key: 'versions' },
  { icon: 'play' as const, key: 'stream' },
  { icon: 'lyrics' as const, key: 'lyrics' },
  { icon: 'list' as const, key: 'queue' },
  { icon: 'disk' as const, key: 'cache' },
];
// i18n-keys: home.f_library_h, home.f_library, home.f_versions_h, home.f_versions, home.f_stream_h, home.f_stream, home.f_lyrics_h, home.f_lyrics, home.f_queue_h, home.f_queue, home.f_cache_h, home.f_cache
const QUICK = [1, 2, 3].map((n) => ({ q: t(`home.q${n}`), a: t(`home.a${n}`) }));
// i18n-keys: home.q1, home.a1, home.q2, home.a2, home.q3, home.a3
const GALLERY_SIZES = '(max-width: 480px) 62vw, 250px';
const HERO_SIZES = '(max-width: 640px) 44vw, 270px';
---
<Base
  path="/"
  title={t('home.title')}
  description={t('home.description')}
>
  <Fragment slot="head">
    <JsonLd data={WEBSITE} />
    <JsonLd data={ORGANIZATION} />
    {INDEXABLE && <JsonLd data={SOFTWARE_APP} />}
  </Fragment>

  <main id="main" class="home">
    <section class="hero" aria-labelledby="title">
      <div class="hero-text">
        <img class="mark" src="/favicon.svg" width="96" height="96" alt="">
        <p class="eyebrow">{t('home.eyebrow', { version: release.version })}</p>
        <h1 id="title">{t('common.app_name')}</h1>
        <p class="lede">{t('home.lede')}</p>
        <p class="notice">{t('common.unofficial')}</p>
        <nav class="links" aria-label={t('home.links')}>
          <a class="link-primary" href="/download/"><Icon name="download" />{t('home.cta_download')}</a>
          <a href="/features/"><Icon name="music" />{t('home.cta_features')}</a>
          <a href={REPO}><Icon name="github" />{t('home.cta_source')}</a>
        </nav>
      </div>
      <div class="hero-phones">
        <PhoneFrame class="hp hp-side hp-left" screen="albums" alt={t('home.hero_albums_alt')} sizes={HERO_SIZES} eager />
        <PhoneFrame class="hp hp-front" screen="home" alt={t('home.hero_home_alt')} sizes={HERO_SIZES} eager priority />
        <PhoneFrame class="hp hp-side hp-right" screen="nowplaying" alt={t('home.hero_now_alt')} sizes={HERO_SIZES} eager />
      </div>
    </section>

    <section class="gallery" aria-labelledby="shots">
      <div class="gallery-head">
        <h2 id="shots">{t('home.shots_h')}</h2>
        <div class="gallery-tools">
          <div class="gallery-nav" data-gallery-nav hidden>
            <button type="button" data-step="-1" aria-label={t('home.prev')}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button type="button" data-step="1" aria-label={t('home.next')}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
        </div>
      </div>
      <p class="gallery-note">{t('home.shots_note')}</p>
      <ul class="shots" tabindex="0" aria-label={t('home.shots_aria')} data-gallery>
        {SHOTS.map((s) => (
          <li>
            <figure>
              <PhoneFrame screen={s.screen} alt={s.alt} sizes={GALLERY_SIZES} />
              <figcaption><strong>{s.title}</strong> {s.text}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <section class="band" aria-labelledby="what">
      <h2 id="what">{t('home.what_h')}</h2>
      <p class="band-lede">{t('home.what_lede')}</p>
      <ul class="cards">
        {FEATURES.map((f) => (
          <li class="card">
            <Icon name={f.icon} />
            <h3>{t(`home.f_${f.key}_h`)}</h3>
            <p>{t(`home.f_${f.key}`)}</p>
          </li>
        ))}
      </ul>
      <p><a class="btn-quiet" href="/features/">{t('home.all_features')}</a></p>
    </section>

    <section class="band" aria-labelledby="start">
      <h2 id="start">{t('home.start_h')}</h2>
      <ol class="steps">
        <li><h3>{t('home.step1_h')}</h3><p><T k="home.step1"><a slot="a1" href="/install/"><T k="home.step1__a1" /></a></T></p></li>
        <li><h3>{t('home.step2_h')}</h3><p>{t('home.step2')}</p></li>
        <li><h3>{t('home.step3_h')}</h3><p>{t('home.step3')}</p></li>
        <li><h3>{t('home.step4_h')}</h3><p>{t('home.step4')}</p></li>
      </ol>
    </section>

    <section class="band" aria-labelledby="is">
      <h2 id="is">{t('home.is_h')}</h2>
      <div class="two">
        <div class="card">
          <h3>{t('home.is_yes')}</h3>
          <ul>
            <li>{t('home.is1')}</li>
            <li>{t('home.is2')}</li>
            <li>{t('home.is3')}</li>
          </ul>
        </div>
        <div class="card">
          <h3>{t('home.is_no')}</h3>
          <ul class="isnt">
            <li>{t('home.not1')}</li>
            <li>{t('home.not2')}</li>
            <li>{t('home.not3')}</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="faq">
      <h2 id="faq">{t('home.faq_h')}</h2>
      <div class="faq">
        {QUICK.map((q) => (
          <details><summary>{q.q}</summary><div><p>{q.a}</p></div></details>
        ))}
      </div>
      <p><a class="btn-quiet" href="/faq/">{t('home.faq_more')}</a></p>
    </section>

    <section class="band" aria-labelledby="get">
      <div class="download-strip">
        <div>
          <h2 id="get">{t('home.get_h', { version: release.version })}</h2>
          <p>{t('home.get_p', { android: release.minAndroid, size: (release.apk.size / 1048576).toFixed(0) })}</p>
        </div>
        <div class="btn-row">
          <a class="btn" href="/download/"><Icon name="download" />{t('home.get_download')}</a>
          <a class="btn-quiet" href="/install/">{t('home.get_install')}</a>
        </div>
      </div>
    </section>

    <SponsorOffer />

    <Sibling />
  </main>
</Base>

<script>
  // The gallery's Previous and Next buttons, shown only when this runs. No timers, nothing stored;
  // the step is one phone, and the scroll is instant under reduced motion.
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const nav = document.querySelector<HTMLElement>('[data-gallery-nav]');
  if (gallery && nav) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    nav.querySelectorAll<HTMLButtonElement>('button[data-step]').forEach((b) => {
      b.addEventListener('click', () => {
        const item = gallery.querySelector('li');
        const step = item ? item.getBoundingClientRect().width : gallery.clientWidth / 2;
        gallery.scrollBy({ left: Number(b.dataset.step) * step, behavior: reduce.matches ? 'auto' : 'smooth' });
      });
    });
    nav.hidden = false;
  }
</script>
