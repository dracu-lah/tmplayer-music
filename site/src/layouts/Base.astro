---
// Every page's <html> and <head>, adapted from tmplayer.org's Base.astro: title, description,
// canonical, robots, author, Open Graph with the image's type and size, og:locale, the four
// twitter: tags, the icons and the manifest. Page-specific JSON-LD goes in the "head" slot.
//
// Robots follow INDEXABLE in site.config.mjs. While it is false (the placeholder) every page is
// noindex, nofollow, whatever it asks for; the X-Robots-Tag header (astro.config.mjs) says the same.
import cssUrl from '../styles/styles.css?url';
import { INDEXABLE, ORIGIN } from '../../site.config.mjs';
import { t } from '../i18n/t';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CoffeeCard from '../components/CoffeeCard.astro';
import CoffeeDialog from '../components/CoffeeDialog.astro';
import UpiDialog from '../components/UpiDialog.astro';

interface Props {
  /** the page's path, such as / */
  path: string;
  title: string;
  description: string;
  /** og:title and twitter:title, when they differ from the <title> */
  socialTitle?: string;
  imageAlt?: string;
  /** the 404 page: noindex, no canonical and no social tags */
  notFound?: boolean;
  /** no floating support card (the support page, where the offer is the subject) */
  noCard?: boolean;
  /** the open graph type: website for most pages, article for a release */
  ogType?: 'website' | 'article';
}
const { path, title, socialTitle = title, description, imageAlt = t('common.og_alt'), notFound = false, noCard = false, ogType = 'website' } = Astro.props;
const url = ORIGIN + path;
// Bump ?v= whenever og.png changes, so the social sites fetch the new one.
const OG_IMAGE = `${ORIGIN}/og.png?v=2`;
const robots = INDEXABLE ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, nofollow';
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{notFound ? <meta name="robots" content="noindex"> : <Fragment>
<link rel="canonical" href={url}>
{/* Placeholder: noindex until launch. See INDEXABLE in site.config.mjs and "Going live" in README.md. */}
<meta name="robots" content={robots}>
<meta name="author" content="dracu-lah">
</Fragment>}
<meta name="theme-color" content="#000000">
<meta name="color-scheme" content="dark">
{!notFound && <Fragment>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="TMPlayer Music">
<meta property="og:title" content={socialTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={OG_IMAGE}>
<meta property="og:image:secure_url" content={OG_IMAGE}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={imageAlt}>
<meta property="og:locale" content="en_US">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={socialTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={OG_IMAGE}>
<meta name="twitter:image:alt" content={imageAlt}>
</Fragment>}

<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{!notFound && <Fragment>
<link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="/icon-512.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title="TMPlayer Music releases" href="/changelog/feed.xml">
</Fragment>}
<link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>document.documentElement.classList.add("js")</script>
<link rel="stylesheet" href={cssUrl}>
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">{t('common.skip')}</a>
<Header path={path} />
<slot />
<Footer />
<CoffeeDialog />
<UpiDialog />
{!notFound && !noCard && <CoffeeCard />}
<script>import '../scripts/site';</script>
</body>
</html>
