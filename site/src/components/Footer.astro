---
// The footer on every page: the unofficial notice, three link columns, a community column with the
// ways to chip in, and a link to the sibling app TMPlayer.
import { BMC_URL, REPO_URL, SPONSORS_URL, ISSUES_URL } from '../lib/support';
import { FOOTER } from '../lib/nav';
import Icon from './Icon.astro';
import { t } from '../i18n/t';
---
<footer class="footer">
  <div class="footer-in">
    <div class="footer-about">
      <p class="footer-brand"><Icon name="brand" size={22} class="footer-mark" /><strong>{t('common.app_name')}</strong></p>
      <p>{t('footer.about')}</p>
      <p class="footer-unofficial">{t('common.unofficial')}</p>
    </div>
    <nav class="footer-cols" aria-label={t('footer.label')}>
      {FOOTER.map((c) => (
        <div>
          <h2>{t(c.title)}</h2>
          <ul>{c.items.map((i) => <li><a href={i.href}>{t(i.label)}</a></li>)}</ul>
        </div>
      ))}
      <div>
        <h2>{t('footer.community')}</h2>
        <ul>
          <li><a class="footer-icon" href={REPO_URL} rel="noopener"><Icon name="github" size={14} />{t('footer.source')}</a></li>
          <li><a href={ISSUES_URL} rel="noopener">{t('footer.report')}</a></li>
          <li><a class="footer-bmc" href={BMC_URL} rel="noopener" data-bmc><img src="/brand/bmc-cup-on-yellow.svg" alt="" width="10" height="14" loading="lazy" decoding="async">{t('footer.coffee')}</a></li>
          <li><a href={SPONSORS_URL} rel="noopener">{t('footer.sponsor')}</a></li>
          <li><a class="footer-icon" href="https://tmplayer.org/"><img src="/brand/tmplayer.svg" alt="" width="14" height="14" loading="lazy" decoding="async">{t('footer.video')}</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <p class="footer-base">&copy; {t('footer.copyright')} <a href="/changelog/feed.xml">{t('footer.feed')}</a></p>
</footer>
