---
// Small inline line icons for the site's links, drawn on a 24 unit grid in currentColor so they take
// the link's colour. Decorative: the link's own words say where it goes, so every icon is
// aria-hidden. The GitHub mark is GitHub's own (Octicons, MIT), the rest are plain shapes.
// "brand" is the app's mark from art/logo.svg: a rounded tile with a note cut out of it.
type Name = 'github' | 'legal' | 'play' | 'heart' | 'help' | 'arrow' | 'brand';
interface Props {
  name: Name;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
const filled = name === 'github' || name === 'brand';
const viewBox = name === 'brand' ? '0 0 56 56' : name === 'github' ? '0 0 16 16' : '0 0 24 24';
---
<svg
  class:list={['icon', className]}
  viewBox={viewBox}
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'github' && <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>}
  {name === 'legal' && <Fragment><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/></Fragment>}
  {name === 'play' && <Fragment><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"/></Fragment>}
  {name === 'heart' && <path d="M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 10c0 5.65-7 10-7 10z"/>}
  {name === 'help' && <Fragment><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14"/><path d="M12 17.5v.01"/></Fragment>}
  {name === 'arrow' && <path d="M7 17L17 7M9 7h8v8"/>}
  {name === 'brand' && <path fill-rule="evenodd" d="M10.89,2 H45.11 A8.89,8.89 0 0 1 54,10.89 V45.11 A8.89,8.89 0 0 1 45.11,54 H10.89 A8.89,8.89 0 0 1 2,45.11 V10.89 A8.89,8.89 0 0 1 10.89,2 Z M19.7,17.34 L44,13.25 L44,32.62 A6.52,4.79 -22 1,1 39.92,28.68 L39.92,20.48 L23.78,23.19 L23.78,36.61 A6.52,4.79 -22 1,1 19.7,32.67 Z"/>}
</svg>
