---
// A troubleshooting guide as a card: an icon, its heading, the one line of what you see, and the link.
// The whole card is the link (a.card in the shared stylesheet), so the tap target is the card.
import Icon from '../Icon.astro';
import { t } from '../../i18n/t';
import type { Guide } from '../../data/troubleshooting';

interface Props { guide: Guide }
const { guide } = Astro.props;
---
<li>
  <a class="card guide-card" href={`/troubleshooting/${guide.slug}/`}>
    <Icon name={guide.icon} size={24} />
    <h3>{t(`${guide.prefix}_h1`)}</h3>
    <p>{t(`${guide.prefix}_card`)}</p>
    <span class="guide-open">{t('trouble.index_open')}<Icon name="arrow" size={14} /></span>
  </a>
</li>

<style>
  .guide-card { height: 100%; }
  .guide-open { display: inline-flex; align-items: center; gap: .375rem; margin-top: auto; padding-top: .5rem; color: var(--accent); font-size: .9375rem; font-weight: 600; }
</style>
