---
// One release's APK: the Download button, then the facts (version, file, size, date, the Android it
// needs) and the SHA-256 with a copy button. Used by the Download page and by each release page of
// the changelog. The copy button is wired by src/scripts/site.ts (data-copy, data-copied,
// data-copy-label) and shown only when scripts run, as the UPI ID's in the support dialog.
import Icon from '../Icon.astro';
import { t } from '../../i18n/t';
import { longDate, megabytes, type Apk } from '../../lib/releases';

interface Props {
  apk: Apk;
  version: string;
  /** YYYY-MM-DD */
  date: string;
  minAndroid: string;
}
const { apk, version, date, minAndroid } = Astro.props;
---
<div class="apk-card">
  <a class="btn apk-btn" href={apk.url} rel="noopener"><Icon name="download" size={20} />{t('download.button')}</a>
  <dl class="apk-facts">
    <div><dt>{t('download.facts_version')}</dt><dd>{version}</dd></div>
    <div><dt>{t('download.facts_file')}</dt><dd><code>{apk.name}</code></dd></div>
    <div><dt>{t('download.facts_size')}</dt><dd>{t('download.facts_size_value', { size: megabytes(apk.size) })}</dd></div>
    <div><dt>{t('download.facts_date')}</dt><dd><time datetime={date}>{longDate(date)}</time></dd></div>
    <div><dt>{t('download.facts_needs')}</dt><dd>{t('download.facts_needs_value', { version: minAndroid })}</dd></div>
    <div class="apk-sha">
      <dt>{t('download.facts_sha')}</dt>
      <dd>
        <code>{apk.sha256}</code>
        <button type="button" class="btn-quiet js-only" data-copy={apk.sha256} data-copied={t('download.copied')} aria-label={t('download.copy_aria')} hidden><Icon name="copy" size={16} /> <span data-copy-label>{t('download.copy')}</span></button>
      </dd>
    </div>
  </dl>
</div>

<style>
  .apk-card { margin: 1.5rem 0; padding: 1.5rem; border-radius: var(--radius); background: var(--surface); }
  .apk-btn { color: var(--bg); min-height: 3.5rem; padding: .75rem 2rem; font-size: 1.0625rem; }
  .apk-facts { display: grid; gap: 0; margin: 1.25rem 0 0; }
  .apk-facts > div { display: grid; grid-template-columns: 8rem 1fr; gap: .25rem 1rem; padding: .625rem 0; border-top: 1px solid var(--line); }
  .apk-facts dt { color: var(--muted); font-size: .9375rem; }
  .apk-facts dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .apk-facts code { padding: 0; background: none; }
  .apk-sha dd { display: flex; flex-direction: column; align-items: flex-start; gap: .625rem; }
  .apk-sha .btn-quiet { min-height: 2.75rem; }
  .apk-sha code { font-size: .8125rem; line-height: 1.5; word-break: break-all; }
  @media (max-width: 30rem) {
    .apk-card { padding: 1.25rem; }
    .apk-btn { display: flex; width: 100%; padding-inline: 1rem; }
    .apk-facts > div { grid-template-columns: 1fr; }
  }
</style>
