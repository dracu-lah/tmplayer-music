<?xml version="1.0" encoding="utf-8"?>
<!--
  The tile's surface colour, the same as TMPlayer's so the two icons read as a pair, flooded
  across the whole layer. The launcher crops it to its own shape, so it must be full bleed; the
  mark stays inside the safe circle on the foreground layer.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1E1E28" />
</shape>
