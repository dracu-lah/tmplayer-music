<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      Themed icons on Android 13 and later: the launcher tints this one layer to the wallpaper.
      It is its own drawable because the tint collapses every fill to one colour, which the
      foreground's contrasting fills cannot survive.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
