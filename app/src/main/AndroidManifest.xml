<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Playing with the screen off or in another app: a media playback foreground service (Android 14
         wants the type), and its notification, which Android 13 and later ask the user for. Playback
         works without it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Keeps the sponsor reminder's once a day job (SupportChecks, scheduled only while its switch is
      on) across a restart: JobScheduler drops a persisted job without it. Nothing runs at boot itself.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The self-updater of the GitHub APK: hands the downloaded, checked update to Android's
         installer, without its question where Android 12 and later allow that. A store build
         takes both out again (src/store/AndroidManifest.xml, -PtmStore=true). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".MusicApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TMPlayerMusic">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="33">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the Send logs file to the app the user picks in the share sheet, and the
             downloaded update to the system installer (Android 6 to 11); not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_paths" />
        </provider>

        <!--
          The player and its media session. Exported with the session intent so the system's media
          controls, Bluetooth and car displays can connect to a session that is already running.
          There is no MediaButtonReceiver on purpose: a headset or a car connecting must not start
          playback by itself.
        -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The sponsor reminder's daily check (SupportChecks); only the system's job scheduler binds it. -->
        <service
            android:name=".data.SupportChecks"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          The sponsor reminder's buttons (NoticeActions): Buy me a coffee and Star on GitHub open the
          page in the browser through an activity with no window, Not now only takes the notification
          down. Reached by this app's own notification alone.
        -->
        <activity
            android:name=".data.NoticeLinkActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <receiver
            android:name=".data.NoticeDismissReceiver"
            android:exported="false" />
        <!--
          After the app has updated itself: deletes the downloaded APK and, after an install that
          closed the app, posts "Updated, tap to open". Android sends MY_PACKAGE_REPLACED to the
          app's own package only, so nothing else reaches it.
        -->
        <receiver
            android:name=".data.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
